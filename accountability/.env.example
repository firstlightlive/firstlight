# Copy this file to .env and fill in your Strava app credentials.
# (.env is git-ignored — never commit real secrets.)

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_REFRESH_TOKEN is filled in automatically by authorize.py
STRAVA_REFRESH_TOKEN=

# Redirect must EXACTLY match the "Authorization Callback Domain" in your Strava app.
# Strava only stores the domain (e.g. localhost); the full URI is used here.
STRAVA_REDIRECT_URI=http://localhost:8721/callback

# --- Rule (defaults match the agreed spec) ---
TIMEZONE=Asia/Kolkata
MIN_DURATION_SECONDS=1800
WALK_MIN_DISTANCE_METERS=5000
WALK_TYPES=Walk,Hike

# --- Oath ---
GO_LIVE_DATE=2026-06-20
