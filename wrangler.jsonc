{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstlight",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "website",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "firstlight-proofs"
    }
  ],
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }
  ]
}
