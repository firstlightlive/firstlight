{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firstlight",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Emailed brief — fires hourly at :30 past, 00:30–17:30 UTC (= 06:00–23:00 IST).
  // runBriefEmail() sends a guaranteed digest at the ~07:00 & ~19:00 IST slots and,
  // in between, emails ONLY when the corroborated top-story set changes.
  "triggers": {
    "crons": ["30 0-17 * * *"]
  },
  "assets": {
    "directory": "website",
    "binding": "ASSETS",
    // Route only the PWA shell pages through the Worker first, so it can serve
    // them 200-in-place instead of the edge's 307 .html→clean redirect (which
    // breaks service-worker offline precache). All other assets serve directly.
    "run_worker_first": ["/punch.html", "/admin.html", "/install.html", "/login.html", "/index.html"]
  },
  "r2_buckets": [
    {
      "binding": "PROOFS",
      "bucket_name": "firstlight-proofs"
    }
  ],
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }
  ]
}
